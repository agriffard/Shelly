@page "/account/login"
@layout TenantHub.Web.Components.Layout.MainLayout

<div style="max-width: 400px; margin: 4rem auto;">
    <div class="card">
        <h1>Sign In</h1>

        @if (context.Request.Query.ContainsKey("error"))
        {
            <div style="color: #dc2626; margin-bottom: 1rem;">Invalid email or password.</div>
        }

        <form method="post" action="/api/account/login">
            <input type="hidden" name="returnUrl" value="@context.Request.Query["returnUrl"]" />

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" required />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" required />
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">Sign In</button>
        </form>
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext context { get; set; } = default!;
}
