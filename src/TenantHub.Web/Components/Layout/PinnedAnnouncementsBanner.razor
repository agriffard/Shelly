@implements IAsyncDisposable

@if (pinnedAnnouncements is not null && pinnedAnnouncements.Count > 0)
{
    @foreach (var announcement in pinnedAnnouncements)
    {
        <div class="alert-banner">
            <strong>@announcement.Title</strong> — @announcement.Body
        </div>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private IReadOnlyList<AnnouncementDto>? pinnedAnnouncements;
    private CShells.Lifecycle.IShellScope? shellScope;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Slug)) return;

        try
        {
            var shellRegistry = AppServices.RootProvider.GetService(typeof(CShells.Lifecycle.IShellRegistry)) as CShells.Lifecycle.IShellRegistry;
            if (shellRegistry is null) return;

            var shell = await shellRegistry.GetOrActivateAsync(Slug);
            shellScope = shell.BeginScope();

            var service = shellScope.ServiceProvider.GetService(typeof(IAnnouncementService)) as IAnnouncementService;
            if (service is not null)
                pinnedAnnouncements = await service.GetPinnedAsync();
        }
        catch
        {
            // Shell not found or feature not enabled
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (shellScope is not null)
        {
            await shellScope.DisposeAsync();
            shellScope = null;
        }
    }
}
