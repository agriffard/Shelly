@page "/{Slug}/notes/{Id:guid}"
@layout TenantHub.Web.Components.Layout.TenantLayout
@inherits TenantHub.Web.Components.TenantComponentBase
@inject NavigationManager Navigation

@if (!IsFeatureEnabled) { <FeatureNotAvailable /> }
else if (note is null)
{
    <p>Loading...</p>
}
else
{
    <div class="flex justify-between items-center mb-4">
        <h1>@(isEditing ? "Edit Note" : note.Title)</h1>
        <div class="flex gap-2">
            @if (!isEditing)
            {
                <button class="btn btn-primary" @onclick="StartEditing">Edit</button>
                <button class="btn btn-danger" @onclick="Delete">Delete</button>
            }
            <button class="btn btn-secondary" @onclick="NavigateBack">Back</button>
        </div>
    </div>

    @if (isEditing)
    {
        <div class="card" style="max-width: 600px;">
            <div class="form-group">
                <label>Title</label>
                <input type="text" @bind="editTitle" />
            </div>
            <div class="form-group">
                <label>Body</label>
                <textarea rows="10" @bind="editBody" style="width: 100%;"></textarea>
            </div>
            <div class="flex gap-2">
                <button class="btn btn-primary" @onclick="SaveEdit">Save</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <p style="color: #6b7280; font-size: 0.875rem;">
                @note.CreatedBy &middot; @note.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </p>
            <div style="white-space: pre-wrap;">@note.Body</div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private INoteService? noteService;
    private NoteDto? note;
    private bool isEditing;
    private string editTitle = "", editBody = "";

    protected override string? RequiredFeature => "Notes";

    protected override async Task OnInitializedAsync()
    {
        if (!IsFeatureEnabled) return;
        noteService = GetShellService<INoteService>();
        if (noteService is not null) note = await noteService.GetNoteByIdAsync(Id);
    }

    private void StartEditing() { editTitle = note!.Title; editBody = note.Body; isEditing = true; }
    private void CancelEdit() => isEditing = false;

    private async Task SaveEdit()
    {
        if (noteService is not null)
        {
            await noteService.UpdateNoteAsync(Id, new UpdateNoteRequest(editTitle, editBody));
            note = await noteService.GetNoteByIdAsync(Id);
        }
        isEditing = false;
    }

    private async Task Delete()
    {
        if (noteService is not null) await noteService.DeleteNoteAsync(Id);
        Navigation.NavigateTo($"/{Slug}/notes");
    }

    private void NavigateBack() => Navigation.NavigateTo($"/{Slug}/notes");
}
